ex<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق نختم</title>
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --text-primary: #ffffff;
            --text-secondary: #b3b3b3;
            --accent-color: #81c784;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 90%;
            max-width: 400px;
            background-color: var(--card-bg);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            text-align: center;
            box-sizing: border-box;
        }

        .header h1 {
            font-size: 1.5rem;
            color: var(--accent-color);
            margin-top: 0;
            margin-bottom: 20px;
        }

        .quran-box {
            min-height: 150px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            margin-bottom: 20px;
        }

        .verse-text {
            font-size: 1.35rem;
            line-height: 1.8;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 15px;
        }

        .verse-info {
            font-size: 0.95rem;
            color: var(--accent-color);
            font-weight: bold;
        }

        .btn-next {
            background-color: var(--accent-color);
            color: var(--bg-color);
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s ease;
        }

        .btn-next:active {
            transform: scale(0.98);
            opacity: 0.9;
        }

        .loading {
            font-style: italic;
            color: var(--text-secondary);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header">
            <h1>تطبيق نختم</h1>
        </div>

        <div class="quran-box">
            <div id="verseText" class="verse-text">جاري تحميل الآية...</div>
            <div id="verseInfo" class="verse-info"></div>
        </div>

        <button class="btn-next" onclick="fetchRandomVerse()">آية أخرى</button>
    </div>

    <script>
        // دالة لجلب آية عشوائية من API القرآن الكريم المشهور (Alquran.cloud)
        async function fetchRandomVerse() {
            const verseTextEl = document.getElementById('verseText');
            const verseInfoEl = document.getElementById('verseInfo');
            
            verseTextEl.classList.add('loading');
            verseTextEl.innerText = "جاري جلب الآية...";
            verseInfoEl.innerText = "";

            // القرآن يحتوي على 6236 آية
            const randomVerseNumber = Math.floor(Math.random() * 6236) + 1;

            try {
                // جلب نص الآية مع معلومات السورة
                const response = await fetch(`https://alquran.cloud{randomVerseNumber}/editions/quran-uthmani`);
                const data = await response.data ? response : await response.json();
                
                if (data.code === 200) {
                    const ayah = data.data;
                    
                    // عرض الآية والمعلومات
                    verseTextEl.classList.remove('loading');
                    verseTextEl.innerText = `﴿ ${ayah.text} ﴾`;
                    verseInfoEl.innerText = `[ سورة ${ayah.surah.name} - آية ${ayah.numberInSurah} ]`;
                } else {
                    throw new Error("خطأ في استجابة الخادم");
                }
            } catch (error) {
                verseTextEl.classList.remove('loading');
                verseTextEl.innerText = "حدث خطأ أثناء تحميل الآية. يرجى التأكد من الاتصال بالإنترنت.";
                verseInfoEl.innerText = "";
                console.error(error);
            }
        }

        // تشغيل الدالة تلقائياً عند فتح التطبيق
        window.onload = fetchRandomVerse;
    </script>
</body>
</html>
